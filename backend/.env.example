# Backend environment configuration for the Member Growth Tracker.
# Copy this file to ".env" (same directory) and fill in your values:
#
#     cp .env.example .env
#
# The backend loads .env automatically on startup (via python-dotenv).

# --- Ask Wellington chatbot (optional) -------------------------------------
# Google Gemini API key. When set, "Ask Wellington" answers conversationally
# via Gemini, grounded in your live chapter data. When absent (or if the API
# call fails/times out), it falls back to the built-in deterministic engine.
#
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# The Gemini model to use. gemini-1.5-flash is the fast, free-tier-friendly
# "basic" model and is the default if unset.
GEMINI_MODEL=gemini-1.5-flash

# --- Other optional settings -----------------------------------------------
# Admin API key guarding threshold/snapshot/export endpoints (default below).
# MEMBER_TRACKER_API_KEY=member-tracker-dev-key

# SQLite database path (default: member_tracker.db in the backend dir).
# MEMBER_TRACKER_DB_PATH=member_tracker.db
