# Base URL of the Member Tracker FastAPI backend.
# Default (when unset): http://localhost:8000
# Set to an empty value to issue relative "/api/*" requests through the Vite
# dev proxy configured in vite.config.js.
VITE_API_BASE_URL=http://localhost:8000

# Admin API key sent as the `X-API-Key` header on administrative endpoints
# (threshold config, snapshots, export). Must match the backend's
# MEMBER_TRACKER_API_KEY (default: member-tracker-dev-key).
VITE_API_KEY=member-tracker-dev-key
